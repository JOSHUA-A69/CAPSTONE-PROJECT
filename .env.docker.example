# Docker-only environment variables (do NOT commit real secrets)
# Copy this file to .env.docker and fill with secure values
# PowerShell: Copy-Item .env.docker.example .env.docker

# --- MySQL ---
MYSQL_DATABASE=ereligious_db
# Strong root password for local dev only; for production use Docker/K8s secrets instead
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_USER=laravel
MYSQL_PASSWORD=change-this-user-password

# --- phpMyAdmin ---
# The hostname of the MySQL service defined in docker-compose.yml
PMA_HOST=db
# Match the MYSQL_USER and MYSQL_PASSWORD above
PMA_USER=laravel
PMA_PASSWORD=change-this-user-password
